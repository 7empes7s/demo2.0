{
  "version": "0.3.0",
  "scope": {
    "population_source": "data/lu-jurisdictions.json",
    "thresholds": [
      {
        "tier": "national",
        "min_population": 300000
      },
      {
        "tier": "regional",
        "min_population": 50000
      },
      {
        "tier": "local",
        "min_population": 1000
      },
      {
        "tier": "minor",
        "min_population": 0
      }
    ]
  },
  "tiers": {
    "national": {
      "queue_priority": 1,
      "details_drafted_by": "citizens_vote",
      "review_panel": {
        "min": 50,
        "max": 100
      },
      "review_rounds": 2,
      "delivery_verified_by": "expert_panel_by_lottery",
      "ratification": "full_vote"
    },
    "regional": {
      "queue_priority": 2,
      "details_drafted_by": "citizens_vote",
      "review_panel": {
        "min": 15,
        "max": 30
      },
      "review_rounds": 1,
      "delivery_verified_by": "expert_panel",
      "ratification": "full_vote"
    },
    "local": {
      "queue_priority": 3,
      "details_drafted_by": "operator",
      "review_panel": {
        "min": 5,
        "max": 9
      },
      "review_rounds": 1,
      "delivery_verified_by": "local_crowd_photo_proof",
      "ratification": "local_vote"
    },
    "minor": {
      "queue_priority": 4,
      "details_drafted_by": "operator",
      "review_panel": {
        "min": 3,
        "max": 3
      },
      "review_rounds": 1,
      "delivery_verified_by": "local_crowd_photo_proof",
      "ratification": "silent_ratification"
    }
  },
  "silent_ratification": {
    "objection_window_days": 14,
    "objection_share_to_force_vote": 0.01
  },
  "delegation": {
    "cap_share_of_electorate": 0.01,
    "max_depth": 1,
    "ttl_months": 12
  },
  "vote_budget": {
    "matters_per_week": 5
  },
  "bans": {
    "bar_years_by_rating": {
      "good": 0,
      "mixed": 0,
      "poor": 2,
      "failed": 4
    },
    "good_rating_reward": "auto_shortlist"
  },
  "reopen_windows": {
    "delivery_verdict_days": 90
  },
  "door": {
    "epoch_months": 12,
    "revoked_id_credential": "survives_until_epoch_end"
  },
  "eligibility": {
    "outsiders": "advise"
  },
  "compensation": {
    "panel": "stipend_multi_week",
    "review": "none"
  },
  "agora": {
    "upvote_hidden_hours": 24
  },
  "scope_challenge": {
    "panel_size": 5,
    "decision_days": 7
  },
  "arena": {
    "max_pass_rate_gap": 0.1
  },
  "watchtower": {
    "max_false_flag_rate": 0.05
  },
  "treasury": {
    "max_tranche_share": 0.5
  },
  "charter_change": {
    "majority": {
      "numerator": 2,
      "denominator": 3
    },
    "quorum_share_of_electorate": 0.2
  },
  "protected_rights": [
    {
      "id": "life_and_bodily_integrity",
      "topics": [
        "rights.life",
        "rights.bodily_integrity"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "right to life and to physical and mental integrity; prohibition of torture and inhuman or degrading treatment",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Articles 2 and 3",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "equality_and_non_discrimination",
      "topics": [
        "rights.equality"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "equality before the law; prohibition of discrimination",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Article 14 and Protocol 12",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "freedom_of_expression_and_press",
      "topics": [
        "rights.expression"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "freedom of expression and of the press",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Article 10",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "freedom_of_assembly_and_association",
      "topics": [
        "rights.assembly",
        "rights.association"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "freedom of peaceful assembly and freedom of association",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Article 11",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "freedom_of_conscience_and_religion",
      "topics": [
        "rights.conscience"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "freedom of thought, conscience and religion",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Article 9",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "privacy_and_data_protection",
      "topics": [
        "rights.privacy"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "respect for private and family life, the home and correspondence; protection of personal data",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Article 8",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "fair_trial_and_due_process",
      "topics": [
        "rights.fair_trial"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés",
        "right": "access to a court and a fair trial; no removal from the judge the law assigns; legality of offences and penalties",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Articles 6 and 7",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "right_to_vote_and_secret_ballot",
      "topics": [
        "rights.vote",
        "democracy.ballot_secrecy"
      ],
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "Chapitre 2, Des droits et libertés, and the chapter on the Chambre des Députés (elections)",
        "right": "universal suffrage and the secret ballot",
        "status": "to_verify",
        "cross_references": [
          {
            "instrument": "echr",
            "article": "Protocol 1, Article 3",
            "status": "to_verify"
          }
        ]
      }
    },
    {
      "id": "anonymity_of_participation",
      "topics": [
        "democracy.participant_anonymity"
      ],
      "basis": "project",
      "source": {
        "instrument": "d2_architecture",
        "article": "docs/architecture/01-modules.md, section 3 (Door) and section 5 (Booth)",
        "status": "none",
        "note": "This project's extension of ballot secrecy to every act of participation (upvotes, panels, challenges). No legal instrument requires it."
      }
    }
  ],
  "sources": {
    "lu_constitution_2023": {
      "name": "Constitution du Grand-Duché de Luxembourg (révision 2023, texte en vigueur depuis le 1er juillet 2023)",
      "publisher": "Legilux (legilux.public.lu)",
      "consulted": false,
      "note": "Cited by chapter until the 2023 article numbering is verified. Pre-2023 article numbers are not used."
    },
    "lu_electoral_law": {
      "name": "Loi électorale modifiée du 18 février 2003",
      "publisher": "Legilux (legilux.public.lu)",
      "consulted": false,
      "note": "Who may vote in national and communal elections; residence and nationality conditions."
    },
    "echr": {
      "name": "Convention européenne des droits de l'homme (ECHR) and its protocols",
      "publisher": "Council of Europe",
      "consulted": false,
      "note": "Cross-reference only. Luxembourg is bound by it; the Constitution is the primary source here."
    },
    "d2_architecture": {
      "name": "Democracy2.0 architecture documents (docs/architecture/)",
      "publisher": "this repository",
      "consulted": true,
      "note": "The project's own design choices. A charter_change vote may change these rules."
    }
  },
  "provenance": {
    "charter_change.majority": {
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "chapter on the revision of the Constitution",
        "status": "to_verify",
        "note": "The decision of 2026-10-06 makes the Charter the Constitution for the Luxembourg version, so changing it must follow the constitutional revision procedure. The two-thirds majority of votes cast is provisional until the revision chapter is read; it is expected to set a qualified majority of the Chambre des Députés, possibly with a referendum. The rule becomes project-chosen if the chapter sets no majority a citizen vote can mirror."
      }
    },
    "charter_change.quorum_share_of_electorate": {
      "basis": "constitution",
      "source": {
        "instrument": "lu_constitution_2023",
        "chapter": "chapter on the revision of the Constitution",
        "status": "to_verify",
        "note": "Kept only if the revision procedure or the referendum rules set a turnout condition; otherwise this rule becomes project-chosen."
      }
    },
    "eligibility.outsiders": {
      "basis": "law",
      "source": {
        "instrument": "lu_electoral_law",
        "chapter": "provisions on the right to vote in legislative and communal elections (nationality, residence, registration)",
        "status": "to_verify",
        "note": "Who votes where follows the electoral law (nationality for national elections, residence for communal ones). The Charter only adds that non-voters may advise."
      }
    },
