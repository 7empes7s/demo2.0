[Unit]
Description=Civic Commons: the argument library the Companion's devil's advocate draws from
After=network-online.target
Wants=network-online.target
# The deployer restarts only civic-companion.service; PartOf makes a deploy (and a stop or a
# restart of the Companion) restart this service too, so both run the same release.
PartOf=civic-companion.service

[Service]
User=civic
Group=civic
WorkingDirectory=/opt/civic/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Same uv locations as civic-docket.service. Commons needs numpy, so the first sync takes longer.
Environment=UV_PROJECT_ENVIRONMENT=/opt/civic/shared/venv UV_CACHE_DIR=/opt/civic/shared/uv-cache UV_PYTHON_INSTALL_DIR=/opt/civic/shared/python
# Serves the seed library shipped in the release (modules/commons/seed/esch.json), read only.
# Loopback only: only the Companion server calls it (COMMONS_URL in companion.env). Port 8093:
# 8090 is Provenance, 8091 Agora (also d2-commons' own default) and 8092 is kept for Door.
ExecStart=/usr/bin/env uv run --frozen --no-dev --package d2-commons d2-commons serve --library /opt/civic/current/modules/commons/seed/esch.json --host 127.0.0.1 --port 8093
Restart=on-failure
RestartSec=3
# Hardening: read-only system, no new privileges, private /tmp. uv may write only its own
# environment and cache. The install creates these directories; if one is missing the unit fails
# at start with a clear error instead of uv failing on a read-only file system.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadOnlyPaths=/opt/civic
ReadWritePaths=/opt/civic/shared/venv /opt/civic/shared/uv-cache /opt/civic/shared/python
MemoryMax=512M

[Install]
WantedBy=multi-user.target civic-companion.service
