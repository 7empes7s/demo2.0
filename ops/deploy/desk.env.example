# /etc/civic/desk.env, mode 600. Read by civic-desk.service. Never commit the real file.
# The first admin. Used only while the staff table is empty: Desk creates the admin "admin"
# with this password on start, then ignores it. Change the password in the admin portal after
# the first sign-in, then blank this line.
DESK_BOOTSTRAP_PASSWORD=
# The model Desk uses to sort feedback, draft answers and translate updates: the same endpoint
# as the Companion (companion.env). An admin can set another one in the portal; that one wins.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
#LLM_TIMEOUT_MS=120000
# The daily public fingerprint of the Desk log: one signed checkpoint per day at
# /api/desk/fingerprints, timestamped through OpenTimestamps. The name is public and never
# changes once the key exists (the key is made on first start: /var/lib/civic-desk/log.key,
# mode 600; back it up with desk.db). Leave empty to keep it off.
DESK_LOG_NAME=
#DESK_OTS_CALENDARS=off
