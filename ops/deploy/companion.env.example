# /etc/civic/companion.env, mode 600. Read by civic-companion.service. Never commit the real file.
# The model: any OpenAI-compatible chat endpoint, up to and including /v1. No vendor SDK.
#   Ollama on the box:   AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=qwen2.5:7b-instruct   (no key)
#   vLLM / llama.cpp:    AI_BASE_URL=http://127.0.0.1:8000/v1   AI_MODEL=<served model>
#   Groq free tier:      AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile  AI_API_KEY=…
#   OpenRouter:          AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=<vendor/model>  AI_API_KEY=…
# Leave AI_BASE_URL empty to run with no model: the app still serves files, claim checks and ideas.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Extra headers some gateways want, "Name: value; Name: value" (OpenRouter: HTTP-Referer, X-Title).
AI_HEADERS=
# Whole-call deadline. Open-weight models on a small box can take a minute. Default 120000.
AI_TIMEOUT_MS=120000
# One JSON line per model call (purpose, model, prompt hash, sizes, timing, never resident text).
# Read by the audit portal. The civic user must be able to write it.
AI_LOG=/opt/civic/shared/ai-calls.jsonl
# Only when AI_BASE_URL is empty: Anthropic's own API (a hosted vendor; not the default).
ANTHROPIC_API_KEY=
COMPANION_MODEL=claude-sonnet-5-5
SNAPSHOT=/opt/civic/shared/lu-chd.json
# The argument library (civic-commons.service). Empty or unreachable (2 s): the devil's advocate
# argues from the file's documents only. Optional: it never gates deploys, so it is not in HEALTH_URLS.
COMMONS_URL=http://127.0.0.1:8093
STATIC_DIR=/opt/civic/current/apps/citizen/dist
# The Companion's port (code default 8787). If you change it, use the same port in deploy.env
# HEALTH_URLS and in the Caddyfile or cloudflared.yml upstream (Mulinux uses 8788).
PORT=8787
# Loopback only: the tunnel (or Caddy) is the only way in, so X-Forwarded-For can be trusted.
HOST=127.0.0.1
# Caddy is the one proxy in front, so the client address is the last X-Forwarded-For entry.
TRUST_PROXY=1
# The claim checker (civic-provenance.service). Unreachable: the app says the checker is unavailable.
PROVENANCE_URL=http://127.0.0.1:8090
# The ideas list (civic-agora.service), read only. Unreachable: the app says the list is unavailable.
# Optional: it never gates deploys, so it is not in HEALTH_URLS.
AGORA_URL=http://127.0.0.1:8091
