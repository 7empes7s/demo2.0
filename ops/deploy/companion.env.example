# /etc/civic/companion.env, mode 600. Read by civic-companion.service. Never commit the real file.
# The model. Any server that speaks the OpenAI chat-completions API (see modules/companion/README.md,
# "Choosing a model"). Nothing heavy runs on Mulinux, so no local model here: until Marouane's own
# hardware runs Ollama, the bridge is a free tier with an open-weight model (Groq or OpenRouter).
# LLM_PROVIDER defaults to openai when LLM_BASE_URL is set.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# One attempt's wait in ms (default 120000). 429 and 5xx are retried twice.
#LLM_TIMEOUT_MS=120000
# Older path, not the plan: set ANTHROPIC_API_KEY (and LLM_MODEL) with no LLM_BASE_URL.
#ANTHROPIC_API_KEY=
SNAPSHOT=/opt/civic/shared/lu-chd.json
# The argument library (civic-commons.service). Empty or unreachable (2 s): the devil's advocate
# argues from the file's documents only. Optional: it never gates deploys, so it is not in HEALTH_URLS.
COMMONS_URL=http://127.0.0.1:8093
STATIC_DIR=/opt/civic/current/apps/citizen/dist
# The Companion's port (code default 8787). If you change it, use the same port in deploy.env
# HEALTH_URLS and in the Caddyfile or cloudflared.yml upstream (Mulinux uses 8788).
PORT=8787
# Loopback only: the tunnel (or Caddy) is the only way in, so X-Forwarded-For can be trusted.
HOST=127.0.0.1
# Caddy is the one proxy in front, so the client address is the last X-Forwarded-For entry.
TRUST_PROXY=1
# The claim checker (civic-provenance.service). Unreachable: the app says the checker is unavailable.
PROVENANCE_URL=http://127.0.0.1:8090
# The ideas list (civic-agora.service), read only. Unreachable: the app says the list is unavailable.
# Optional: it never gates deploys, so it is not in HEALTH_URLS.
AGORA_URL=http://127.0.0.1:8091
# The desk (civic-desk.service): feedback, ideas, votes, procedures and the staff portals' API.
# The Companion forwards /api/desk/* to it. Optional: not in HEALTH_URLS, the app says the desk
# is unavailable when it is down.
DESK_URL=http://127.0.0.1:8094
# The built staff portals (apps/portal/dist), served under /portal/.
PORTAL_DIR=/opt/civic/current/apps/portal/dist
