# /etc/civic/deploy.env, mode 600. Read by app-deploy@civic.service (brain/templates/deploy).
APP=civic
REPO=7empes7s/demo2.0
SERVICE=civic-companion.service
# Provenance (8090) is not a deploy gate: claim checking is optional, and the Companion's /healthz
# reports it as "provenance": true|false.
HEALTH_URLS="http://127.0.0.1:8787/healthz"
# Light: npm ci plus a ~1 s Vite build. Python (uv) is needed by the Docket timer and civic-provenance.
# The first step drops the token from the clone so it never sits in a release's .git/config.
BUILD_CMD="git remote set-url origin https://github.com/7empes7s/demo2.0.git && npm ci --no-audit --no-fund && npm run build -w @democracy2/citizen"
# GH_TOKEN=   fine-grained token for 7empes7s/demo2.0: contents read, commit statuses write, actions read
