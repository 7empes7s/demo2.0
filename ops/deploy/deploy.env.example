# /etc/civic/deploy.env, mode 600. Read by app-deploy@civic.service (brain/templates/deploy).
APP=civic
REPO=7empes7s/demo2.0
SERVICE=civic-companion.service
HEALTH_URLS="http://127.0.0.1:8787/healthz"
# Light: npm ci plus a ~1 s Vite build. Python is only needed by the Docket timer.
BUILD_CMD="npm ci --no-audit --no-fund && npm run build -w @democracy2/citizen"
# GH_TOKEN=   fine-grained token for 7empes7s/demo2.0: contents read, commit statuses write, actions read
