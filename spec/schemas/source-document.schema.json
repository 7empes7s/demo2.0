{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://democracy2.dev/spec/source-document.schema.json",
  "title": "SourceDocument",
  "description": "An original file as fetched from its source, addressed by its content hash. Owned by Docket.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "fetched_at": {
      "description": "RFC 3339 timestamp.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mime": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$" },
    "storage_uri": { "type": "string", "format": "uri", "minLength": 1 }
  },
  "required": ["id", "url", "fetched_at", "sha256", "mime", "storage_uri"],
  "additionalProperties": false
}
